from Crypto.Util.number import bytes_to_long,long_to_bytes,isPrime
from flag import flag
import gmpy2
import random
import os

seed = bytes_to_long(b"Seed" + os.urandom(32))
genertor = random.Random(seed)
def get_prime(key_size, genertor=None):
    while True:
        if genertor != None:
            num = genertor.randrange(2**(key_size-1), 2**key_size)
        else:
            num = random.randrange(2**(key_size-1), 2**key_size)
        if isPrime(num):
            return num
        
p = get_prime(1024, genertor=genertor)
x = get_prime(1024)
while x > p:
    x = get_prime(1024)

enc = bytes_to_long(flag) ^^ x

rs = []
cs = []
for i in range(30):
    r = get_prime(1024, genertor=genertor)
    e = get_prime(888)
    c = (r * x + e) % p
    rs.append(r)
    cs.append(c)

length = len(bin(seed)) - 2 
a = get_prime(length)
b = get_prime(length)
n = get_prime(length)

seeds = []
for i in range(10):
    seed = (a * seed + b) % n
    seeds.append(seed)

print("cs =", cs)
print("seeds =", seeds)
print("enc = ", enc)

