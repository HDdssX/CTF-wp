<% var title = "Search - AAA'26 Big-1"; %>
<%- include('partials/header') %>

<h2>Search My Papers</h2>
<p class="text-muted small">Search supports numeric optimism only; prose belongs in rebuttal.</p>
<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-warning"><%= error %></div>
<% } %>
<form method="GET" action="/search" class="row g-3 mb-4">
  <div class="col-md-3">
    <label class="form-label">Paper ID digits contain</label>
    <input name="paperId" inputmode="numeric" pattern="[0-9]*" maxlength="8" class="form-control" value="<%= query.paperId || '' %>">
  </div>
  <div class="col-md-3">
    <label class="form-label">Minimum score</label>
    <input name="scoreMin" type="number" min="1" max="10" step="0.1" class="form-control" value="<%= query.scoreMin || '' %>">
  </div>
  <div class="col-md-3">
    <label class="form-label">Minimum confidence</label>
    <input name="confidenceMin" type="number" min="1" max="5" step="0.1" class="form-control" value="<%= query.confidenceMin || '' %>">
  </div>
  <div class="col-md-3 d-flex align-items-end">
    <button class="btn btn-primary w-100">Search</button>
  </div>
</form>

<table class="table table-striped">
  <thead><tr><th>ID</th><th>Title</th><th>Average Score</th><th>Confidence</th><th>Status</th></tr></thead>
  <tbody>
    <% papers.forEach((paper) => { %>
      <tr>
        <td><a href="/papers/<%= paper._id %>/view"><%= paper.publicId %></a></td>
        <td><%= paper.title %></td>
        <td><%= paper.avgScore === null ? 'n/a' : paper.avgScore.toFixed(1) %></td>
        <td><%= paper.avgConfidence === null ? 'n/a' : paper.avgConfidence.toFixed(1) %></td>
        <td><span class="badge bg-<%= statusClass(paper.status) %>"><%= paper.status %></span></td>
      </tr>
    <% }) %>
    <% if (!papers.length) { %>
      <tr><td colspan="5" class="text-muted">No papers match the numeric filters. The confidence interval declines to comment.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('partials/footer') %>
