<% var title = "Dashboard - AAA'26 Big-1"; %>
<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h2 class="mb-1">Conference Dashboard</h2>
    <p class="text-muted mb-0">Signed in as <strong><%= user.username %></strong> <span class="badge text-bg-secondary"><%= user.role %></span></p>
    <p class="text-muted small mb-0">Venue: <%= conference.venue %></p>
    <p class="text-muted small mb-0">Status: the PC is calm, which is how you know the deadline is fictional.</p>
  </div>
  <a href="/papers/new" class="btn btn-success">Register Paper</a>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="metric">
      <div class="metric-label">Your Papers</div>
      <div class="metric-value"><%= papers.length %></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="metric">
      <div class="metric-label">Review Assignments</div>
      <div class="metric-value"><%= assignmentCount %></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="metric">
      <div class="metric-label">Reviews Filed</div>
      <div class="metric-value"><%= reviewCount %></div>
    </div>
  </div>
</div>

<h4>Recent Submissions</h4>
<table class="table table-striped">
  <thead><tr><th>Paper</th><th>Title</th><th>Score</th><th>Status</th><th></th></tr></thead>
  <tbody>
    <% papers.forEach((paper) => { %>
      <tr>
        <td><%= paper.publicId %></td>
        <td><%= paper.title %></td>
        <td><%= paper.avgScore === null ? 'n/a' : paper.avgScore.toFixed(1) %></td>
        <td><span class="badge bg-<%= statusClass(paper.status) %>"><%= paper.status %></span></td>
        <td>
          <div class="paper-actions">
            <a class="btn btn-sm btn-outline-primary" href="/papers/<%= paper._id %>/view">View</a>
            <% if (paper.status === 'Registered') { %>
              <form method="POST" action="/papers/<%= paper._id %>/submit">
                <button class="btn btn-sm btn-success">Submit</button>
              </form>
            <% } %>
          </div>
        </td>
      </tr>
    <% }) %>
    <% if (!papers.length) { %>
      <tr><td colspan="5" class="text-muted">No papers yet.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('partials/footer') %>
