<% var title = "Reviewer Claim - AAA'26 Big-1"; %>
<%- include('../partials/header') %>

<h2>Reviewer Invitation Claim</h2>
<p class="text-muted">Program committee invitations are tied to an email address and a one-time code. Track names may still be TBD; this is considered normal governance.</p>

<form method="POST" action="/reviewer/claim" class="narrow-form">
  <div class="mb-3">
    <label class="form-label">Invitation email</label>
    <input name="email" type="email" class="form-control" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Invitation code</label>
    <input name="code" class="form-control" required>
  </div>
  <button class="btn btn-primary">Claim Reviewer Role</button>
</form>

<%- include('../partials/footer') %>
