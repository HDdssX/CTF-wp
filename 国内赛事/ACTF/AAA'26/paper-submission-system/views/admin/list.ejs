<% var title = "Admin Papers - AAA'26 Big-1"; %>
<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="mb-0">All Papers</h2>
    <p class="text-muted small mb-0">Chair console: where optimism becomes a dropdown.</p>
  </div>
  <div>
    <a class="btn btn-outline-secondary" href="/admin/users">Users</a>
    <a class="btn btn-outline-secondary" href="/admin/reviewer-invites">Invites</a>
    <a class="btn btn-outline-secondary" href="/admin/service-desk">Service Desk</a>
  </div>
</div>

<table class="table table-bordered">
  <thead><tr><th>ID</th><th>Author</th><th>Title</th><th>Reviews</th><th>Score</th><th>Status</th><th></th></tr></thead>
  <tbody>
    <% papers.forEach((paper) => { %>
      <tr>
        <td><%= paper.publicId %></td>
        <td><%= paper.owner ? paper.owner.username : 'unknown' %></td>
        <td><%= paper.title %></td>
        <td><%= paper.reviewCount %></td>
        <td><%= paper.avgScore === null ? 'n/a' : paper.avgScore.toFixed(1) %></td>
        <td><span class="badge bg-<%= statusClass(paper.status) %>"><%= paper.status %></span></td>
        <td>
          <a href="/papers/<%= paper._id %>/view" class="btn btn-sm btn-primary">View</a>
          <a href="/admin/papers/<%= paper._id %>/status" class="btn btn-sm btn-warning">Decision</a>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../partials/footer') %>
