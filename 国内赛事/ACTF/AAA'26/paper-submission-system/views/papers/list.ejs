<% var title = "My Papers - AAA'26 Big-1"; %>
<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="mb-0">My Papers</h2>
    <p class="text-muted small mb-0">The PC cannot reject a paper you have not registered yet, but it is emotionally prepared.</p>
  </div>
  <a href="/papers/new" class="btn btn-success">Register Paper</a>
</div>

<table class="table table-striped">
  <thead><tr><th>ID</th><th>Title</th><th>Topics</th><th>Reviews</th><th>Score</th><th>Status</th><th></th></tr></thead>
  <tbody>
    <% papers.forEach((paper) => { %>
      <tr>
        <td><%= paper.publicId %></td>
        <td>
          <strong><%= paper.title %></strong>
          <div class="text-muted small"><%= paper.abstract.length > 110 ? paper.abstract.slice(0, 110) + '...' : paper.abstract %></div>
        </td>
        <td><%= (paper.topics || []).join(', ') || 'n/a' %></td>
        <td><%= paper.reviewCount %></td>
        <td><%= paper.avgScore === null ? 'n/a' : paper.avgScore.toFixed(1) %></td>
        <td><span class="badge bg-<%= statusClass(paper.status) %>"><%= paper.status %></span></td>
        <td>
          <div class="paper-actions">
            <a href="/papers/<%= paper._id %>/view" class="btn btn-sm btn-primary">View</a>
            <% if (paper.status === 'Registered') { %>
              <form method="POST" action="/papers/<%= paper._id %>/submit">
                <button class="btn btn-sm btn-success">Submit for Review</button>
              </form>
            <% } %>
          </div>
        </td>
      </tr>
    <% }) %>
    <% if (!papers.length) { %>
      <tr><td colspan="7" class="text-muted">No papers registered yet. Your acceptance rate remains mathematically uninjured.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('../partials/footer') %>
