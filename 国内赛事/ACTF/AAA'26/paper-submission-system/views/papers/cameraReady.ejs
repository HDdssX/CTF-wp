<% var title = "Camera-Ready - AAA'26 Big-1"; %>
<%- include('../partials/header') %>

<h2>Camera-Ready Preparation</h2>
<p class="text-muted">Paper <%= paperPublicId(paper) %>: <%= paper.title %></p>

<div class="alert alert-info">
  Accepted papers must upload a final camera-ready PDF for the <%= conference.shortName %> proceedings.
  The proceedings desk generates a first-page thumbnail for the program.
</div>

<form method="POST" action="/papers/<%= paper._id %>/camera-ready" enctype="multipart/form-data" class="narrow-form">
  <div class="mb-3">
    <label class="form-label">Camera-ready PDF</label>
    <input type="file" name="cameraReadyPdf" accept=".pdf,application/pdf" class="form-control" required>
  </div>
  <button class="btn btn-success">Prepare Proceedings Package</button>
</form>

<%- include('../partials/footer') %>
